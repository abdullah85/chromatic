{
  "name": "Chromatic: Extensions Analytics",
  "version": "0.1.0.0",
  "description": "Save details like ratings, number of users, number of reviews of Chrome Extensions for analysis.",
  "manifest_version": 3,
  "action": {
    "default_title": "Chromatic: Extensions Analytics",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "64": "icons/icon_64.png",
      "128": "icons/icon_128.png"
    }
  },
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "64": "icons/icon_64.png",
    "128": "icons/icon_128.png"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["https://chromewebstore.google.com/*"]
}
